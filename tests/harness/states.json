{
  "description": "The styles mode's interactive state targets (tests/README.md, Tokens and states). The site's markup carries no data-states attributes (Phase 2 changes no markup), so each target names its elements here. Fields: id; selector (its elements: the first max that render, default 2, are replayed); states (hover, focus, focus-visible, active: femto's replay, in this order); routes (exact routes or /^regex/); scope (the closest ancestor matching it holds the subtree collected under each state, so :focus-within parents, :has() and tooltip pseudo-elements are caught; default the element's parent); open (details matching it are opened first and closed after, for menu items); widths (integers or {min, max}: where the elements render); why. Each component is replayed on its own docs route, the shell (header, footer, docs menu) on a few routes, a few elements per component rather than every match.",
  "targets": [
    {"id": "header-nav-links", "selector": "body > header nav a.contrast", "states": ["hover", "focus-visible", "active"], "routes": ["/", "/docs/button"], "scope": "body > header", "max": 2,
     "why": "the header's text and icon links (Examples, Docs, GitHub; the first two that render: at 375 the text links are hidden)"},
    {"id": "header-theme-toggle", "selector": "body > header a[aria-label$=\" dark mode\"]", "states": ["hover", "focus-visible", "active"], "routes": ["/", "/docs/button"], "scope": "body > header", "max": 1,
     "why": "the theme toggle and its emoji (PLAN.md Decision 16); the click that would switch the theme is cancelled"},
    {"id": "header-logo", "selector": "body > header a[aria-label=\"femto homepage\"]", "states": ["hover", "focus-visible"], "routes": ["/docs/button"], "scope": "body > header", "max": 1,
     "why": "the logo link"},
    {"id": "header-version", "selector": "body > header details.dropdown > summary", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/button"], "scope": "body > header", "max": 1,
     "why": "the docs header's version dropdown"},
    {"id": "header-version-item", "selector": "body > header details.dropdown li a", "states": ["hover", "focus-visible"], "routes": ["/docs/button"], "scope": "body > header", "open": "body > header details.dropdown", "max": 1,
     "why": "the version dropdown's item, with the dropdown open"},
    {"id": "skip-link", "selector": "body > a.skip-to-content", "states": ["focus-visible"], "routes": ["/", "/docs/button"], "scope": "body", "max": 1,
     "why": "the skip link, shown only when focused"},
    {"id": "footer-links", "selector": "body > footer a.secondary", "states": ["hover", "focus-visible", "active"], "routes": ["/", "/docs/button"], "scope": "body > footer", "max": 2,
     "why": "the footer's text links"},
    {"id": "footer-icons", "selector": "body > footer a.contrast", "states": ["hover", "focus-visible"], "routes": ["/", "/docs/button"], "scope": "body > footer", "max": 1,
     "why": "the footer's icon links"},
    {"id": "docs-menu-summary", "selector": "#documentation-menu details > summary", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/button"], "scope": "#documentation-menu", "max": 2, "widths": [{"min": 1024}],
     "why": "the docs menu's category summaries (below 1024 px the menu is off-canvas until opened)"},
    {"id": "docs-menu-links", "selector": "#documentation-menu details[open] li a", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/button"], "scope": "#documentation-menu", "max": 2, "widths": [{"min": 1024}],
     "why": "the docs menu's first two links in the open category, Typography and Link on /docs/button (from 1024 px)"},
    {"id": "docs-menu-current", "selector": "#documentation-menu a[aria-current]", "states": ["hover", "focus-visible"], "routes": ["/docs/button"], "scope": "#documentation-menu", "max": 1, "widths": [{"min": 1024}],
     "why": "the docs menu's current link, Button (from 1024 px)"},
    {"id": "docs-toc-links", "selector": "#table-of-contents li a", "states": ["hover", "focus-visible"], "routes": ["/docs/button"], "scope": "#table-of-contents", "max": 2,
     "why": "the table of contents"},
    {"id": "docs-breadcrumb", "selector": "main > nav[aria-label=breadcrumb] a", "states": ["hover", "focus-visible"], "routes": ["/docs/button"], "scope": "main > nav[aria-label=breadcrumb]", "max": 1, "widths": [{"max": 1023}],
     "why": "the breadcrumb's Documentation link (below 1024 px)"},
    {"id": "docs-heading-anchor", "selector": "[role=document] h2 > a.secondary[tabindex=\"-1\"]", "states": ["hover"], "routes": ["/docs/button"], "scope": "[role=document] section", "max": 1,
     "why": "a subheading's # permalink"},
    {"id": "docs-copy-button", "selector": "[role=document] a.copy-to-clipboard", "states": ["hover", "active"], "routes": ["/docs/button"], "scope": "article", "max": 1,
     "why": "the code copy button and its tooltip"},
    {"id": "docs-edit-link", "selector": "[role=document] a.secondary[target=_blank]", "states": ["hover", "focus-visible"], "routes": ["/docs/button"], "scope": "[role=document]", "max": 1,
     "why": "the section's edit link"},
    {"id": "content-links", "selector": "[role=document] article a:not(.copy-to-clipboard)", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/link"], "scope": "article", "max": 3,
     "why": "the link variants: primary, secondary and contrast"},
    {"id": "buttons", "selector": "[role=document] article button:not([disabled])", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/button"], "scope": "article", "max": 3,
     "why": "the button variants: primary, secondary and contrast"},
    {"id": "buttons-outline", "selector": "[role=document] article button.outline", "states": ["hover", "focus-visible"], "routes": ["/docs/button"], "scope": "article", "max": 2,
     "why": "outline buttons"},
    {"id": "buttons-input", "selector": "[role=document] article input:is([type=submit], [type=button], [type=reset])", "states": ["hover", "focus-visible"], "routes": ["/docs/button"], "scope": "article", "max": 2,
     "why": "input buttons"},
    {"id": "buttons-role", "selector": "[role=document] article [role=button]", "states": ["hover", "focus-visible"], "routes": ["/docs/button"], "scope": "article", "max": 1,
     "why": "an element with role=button"},
    {"id": "form-text-inputs", "selector": "[role=document] article input:is([type=text], [type=email])", "states": ["hover", "focus"], "routes": ["/docs/forms/input"], "scope": "article", "max": 2,
     "why": "text inputs"},
    {"id": "form-textarea", "selector": "[role=document] article textarea:not([disabled])", "states": ["focus"], "routes": ["/docs/forms/textarea"], "scope": "article", "max": 1,
     "why": "a textarea"},
    {"id": "form-select", "selector": "[role=document] article select:not([disabled])", "states": ["hover", "focus", "active"], "routes": ["/docs/forms/select"], "scope": "article", "max": 1,
     "why": "a select (its native picker never opens: mousedown is cancelled)"},
    {"id": "form-checkbox", "selector": "[role=document] article input[type=checkbox]:not([role=switch])", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/forms/checkboxes"], "scope": "article", "max": 2,
     "why": "the first two checkboxes, both checked"},
    {"id": "form-checkbox-unchecked", "selector": "[role=document] article input[type=checkbox]:not([role=switch], :checked, [disabled])", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/forms/checkboxes"], "scope": "article", "max": 1,
     "why": "an unchecked checkbox"},
    {"id": "form-radio-checked", "selector": "[role=document] article input[type=radio]:checked", "states": ["focus-visible", "active"], "routes": ["/docs/forms/radios"], "scope": "article", "max": 1,
     "why": "a checked radio (Tab enters a radio group on its checked radio only)"},
    {"id": "form-radio", "selector": "[role=document] article input[type=radio]:not(:checked, [disabled])", "states": ["hover", "active"], "routes": ["/docs/forms/radios"], "scope": "article", "max": 1,
     "why": "an unchecked radio"},
    {"id": "form-switch", "selector": "[role=document] article input[role=switch]:not([disabled])", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/forms/switch"], "scope": "article", "max": 2,
     "why": "an off and an on switch"},
    {"id": "form-range", "selector": "[role=document] article input[type=range]", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/forms/range"], "scope": "article", "max": 1,
     "why": "a range input (its thumb is a vendor pseudo-element the collector cannot read; tests/README.md, Known limits)"},
    {"id": "form-example", "selector": "[role=document] article form input:not([type=submit])", "states": ["focus"], "routes": ["/docs/forms"], "scope": "form", "max": 1,
     "why": "an input in the forms overview's example form"},
    {"id": "form-example-submit", "selector": "[role=document] article form input[type=submit]", "states": ["hover", "focus-visible"], "routes": ["/docs/forms"], "scope": "form", "max": 1,
     "why": "the example form's submit button"},
    {"id": "accordion", "selector": "[role=document] article details > summary", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/accordion"], "scope": "details", "max": 3,
     "why": "an open and a closed accordion, and one whose summary is a button"},
    {"id": "dropdown-summary", "selector": "[role=document] article details.dropdown > summary", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/dropdown"], "scope": "article", "max": 2,
     "why": "dropdown summaries"},
    {"id": "dropdown-items", "selector": "[role=document] article:first-of-type details.dropdown li a", "states": ["hover", "focus-visible"], "routes": ["/docs/dropdown"], "scope": "article", "open": "[role=document] article:first-of-type details.dropdown", "max": 2,
     "why": "the first dropdown's links, with it open"},
    {"id": "nav-links", "selector": "[role=document] article nav a", "states": ["hover", "focus-visible"], "routes": ["/docs/nav"], "scope": "nav", "max": 3,
     "why": "nav links"},
    {"id": "group-inputs", "selector": "[role=document] article [role=group] input:not([type=submit])", "states": ["focus"], "routes": ["/docs/group"], "scope": "[role=group]", "max": 1,
     "why": "an input in a group (the group's :focus-within ring)"},
    {"id": "group-buttons", "selector": "[role=document] article [role=group] :is(button, input[type=submit])", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/group"], "scope": "[role=group]", "max": 2,
     "why": "buttons in a group"},
    {"id": "modal-buttons", "selector": "[role=document] article button", "states": ["hover", "focus-visible"], "routes": ["/docs/modal"], "scope": "article", "max": 2,
     "why": "the modal's buttons"},
    {"id": "tooltips", "selector": "[role=document] article :is(a, button)[data-tooltip]", "states": ["hover", "focus-visible"], "routes": ["/docs/tooltip"], "scope": "article", "max": 2,
     "why": "tooltips on a link and a button (::before and ::after)"},
    {"id": "tooltips-inline", "selector": "[role=document] article em[data-tooltip]", "states": ["hover"], "routes": ["/docs/tooltip"], "scope": "article", "max": 1,
     "why": "a tooltip on an inline element, which takes no focus"},
    {"id": "color-scheme-switcher", "selector": "#theme-switcher button", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/color-schemes"], "scope": "#theme-switcher", "max": 1,
     "why": "the color scheme switcher and its emoji (PLAN.md Decision 16)"},
    {"id": "color-scheme-forced", "selector": "article[data-theme] input[type=text]", "states": ["focus"], "routes": ["/docs/color-schemes"], "scope": "article", "max": 2,
     "why": "inputs in the forced light and dark examples"},
    {"id": "color-swatches", "selector": "[role=document] button.secondary[class*=\"femto-background-\"]", "states": ["hover", "focus-visible", "active"], "routes": ["/docs/colors"], "scope": "article", "max": 2,
     "why": "color swatches"},
    {"id": "picker-swatches", "selector": "[role=document] a[class^=\"femto-background-\"]", "states": ["hover", "focus-visible"], "routes": ["/docs/version-picker", "/docs/version-picker/jade"], "scope": "article", "max": 2,
     "why": "the version picker's first two color swatches, red and pink"},
    {"id": "picker-swatch-current", "selector": "[role=document] a[aria-current][class^=\"femto-background-\"]", "states": ["hover", "focus-visible"], "routes": ["/docs/version-picker/jade"], "scope": "article", "max": 1,
     "why": "the version picker's current swatch, jade, with its check icon"},
    {"id": "picker-form", "selector": "[role=document] article form :is(input[type=text], button[type=submit])", "states": ["hover", "focus"], "routes": ["/docs/version-picker/jade"], "scope": "form", "max": 2,
     "why": "the picker preview's input and button in a theme color"},
    {"id": "landing-cta", "selector": "main a[role=button]", "states": ["hover", "focus-visible", "active"], "routes": ["/"], "scope": "main > section", "max": 2,
     "why": "the landing page's calls to action"},
    {"id": "landing-links", "selector": "main section.features a", "states": ["hover", "focus-visible"], "routes": ["/"], "scope": "main > section", "max": 2,
     "why": "the landing page's feature links"},
    {"id": "examples-links", "selector": "main article a.preview, main article a.edit", "states": ["hover", "focus-visible"], "routes": ["/examples"], "scope": "article", "max": 2,
     "why": "the examples page's card links"}
  ]
}
